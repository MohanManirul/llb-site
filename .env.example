APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
SESSION_SECURE_COOKIE=true

VITE_APP_NAME="${APP_NAME}"
VITE_PORT=5173
APP_URL=https://boneek-crm.test
SANCTUM_STATEFUL_DOMAINS=boneek-crm.test,localhost,127.0.0.1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
# Must stay above the longest job timeout (ProcessClientCsvImport: 900s),
# otherwise a slow CSV import is handed to a second worker while it still runs.
DB_QUEUE_RETRY_AFTER=1200

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# The inventory (boneek) database. Read-mostly, but the call center edits live
# orders: order money and status, order_items, shipping addresses, the customer
# record, order_logs and product_stocks. CLAUDE.md lists every allowed write and
# DEPLOY.md turns that list into the GRANTs this user needs — give it its own
# restricted role rather than inventory's app user.
# Never run migrations against it; the inventory project owns that schema.
BONEEK_DB_DRIVER=pgsql
BONEEK_DB_HOST=127.0.0.1
BONEEK_DB_PORT=5432
BONEEK_DB_DATABASE=inventory
BONEEK_DB_USERNAME=
BONEEK_DB_PASSWORD=
BONEEK_DB_SSLMODE=prefer

# Where the inventory app is served from. Product images are stored there as
# paths relative to its public disk, so the CRM needs this base to show them.
BONEEK_APP_URL=
BONEEK_STORAGE_PATH=storage

CALL_CENTER_PICK_LIMIT=50
CALL_CENTER_ALLOW_UNPICK=true
CALL_CENTER_LOG_ACTOR=Boneek
CALL_CENTER_SERVICE_CHARGE=20

# bdcourier's fraud check, behind the courier score column. The same key the
# inventory app uses; without it the column falls back to what inventory last
# recorded on the customer.
COURIER_SCORE_URL=https://bdcourier.com/api/pro/courier-check
COURIER_SCORE_API_KEY=
COURIER_SCORE_CACHE_DAYS=7

# The password every seeded staff account starts with. Set it before seeding a
# real install; each person should change it at first login.
SEED_USER_PASSWORD=password
