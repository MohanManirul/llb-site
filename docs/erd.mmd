erDiagram

    %% ── Identity & access ───────────────────────────────────────────
    USERS {
        bigint id PK
        string name
        string email UK
        string phone
        string image
        string password
    }

    CLIENTS {
        bigint id PK
        string name
        string email UK
        string phone UK
        string password
        bool is_active
        timestamp deleted_at
    }

    ROLES {
        bigint id PK
        string name
        string guard_name
    }

    PERMISSIONS {
        bigint id PK
        string name
        string guard_name
    }

    MODEL_HAS_ROLES {
        bigint role_id FK
        string model_type
        bigint model_id
    }

    MODEL_HAS_PERMISSIONS {
        bigint permission_id FK
        string model_type
        bigint model_id
    }

    ROLE_HAS_PERMISSIONS {
        bigint permission_id FK
        bigint role_id FK
    }

    PERSONAL_ACCESS_TOKENS {
        bigint id PK
        string tokenable_type
        bigint tokenable_id
        string token UK
    }

    NOTIFICATIONS {
        uuid id PK
        string notifiable_type
        bigint notifiable_id
        text data
        timestamp read_at
    }

    ACTIVITY_LOGS {
        bigint id PK
        string type
        string subject_type
        bigint subject_id
        string causer_type
        bigint causer_id
        text description
    }

    PASSWORD_RESET_TOKENS {
        string email PK
        string token
    }

    CLIENT_PASSWORD_RESET_TOKENS {
        string email PK
        string token
    }

    %% ── Organisation ────────────────────────────────────────────────
    COMPANIES {
        bigint id PK
        string name UK
        string email UK
        bool is_active
        timestamp deleted_at
    }

    DEPARTMENTS {
        bigint id PK
        bigint company_id FK
        string name
        bool is_active
        timestamp deleted_at
    }

    DESIGNATIONS {
        bigint id PK
        string name UK
        bool is_active
    }

    EMPLOYEES {
        bigint id PK
        bigint user_id FK
        bigint company_id FK
        bigint department_id FK
        bigint designation_id FK
        bool is_active
        date joining_date
        date resignation_date
        timestamp deleted_at
    }

    TEAMS {
        bigint id PK
        bigint company_id FK
        bigint department_id FK
        string name
        bool is_active
        timestamp deleted_at
    }

    TEAM_MEMBERS {
        bigint id PK
        bigint team_id FK
        bigint employee_id FK
        enum role
    }

    %% ── Projects & performance ──────────────────────────────────────
    PROJECTS {
        bigint id PK
        bigint company_id FK
        bigint department_id FK
        bigint client_id FK
        bigint team_id FK
        bigint assigned_employee_id FK
        string project_name UK
        date start_date
        date end_date
        decimal package_amount
        decimal amount_paid
        decimal amount_due
        enum project_type
        decimal sales_target
        date target_deadline
        decimal achieved_sales
        enum health_status
        enum business_status
        timestamp deleted_at
    }

    PROJECT_MILESTONES {
        bigint id PK
        bigint company_id FK
        bigint project_id FK
        smallint sequence
        date period_start
        date period_end
        decimal target_amount
        decimal achieved_amount
        enum status
    }

    SALES_REPORTS {
        bigint id PK
        bigint company_id FK
        bigint project_id FK
        date week_start
        date week_end
        decimal total_sales
        int total_order_quantity
        decimal total_amount_spent
    }

    PROJECT_SALES {
        bigint id PK
        bigint company_id FK
        bigint project_id FK
        bigint project_milestone_id FK
        bigint team_id FK
        bigint employee_id FK
        date sale_date
        decimal amount
        string reference
    }

    PROJECT_ASSIGNMENTS {
        bigint id PK
        bigint company_id FK
        bigint project_id FK
        bigint team_id FK
        bigint employee_id FK
        timestamp assigned_at
        timestamp unassigned_at
        enum reason
    }

    PROJECT_NOTES {
        bigint id PK
        bigint company_id FK
        bigint project_id FK
        bigint user_id FK
        text note
    }

